# Safe, commit-friendly template. Copy values into your local .env (git-ignored).
# NEVER put real keys in this file. See README -> "Secrets & credentials".

ACTIVE_PROFILE=gtm_devrel
YOUR_NAME="Your Name"
YOUR_ONE_LINER="Full-stack AI product engineer — building end-to-end AI products."

# --- AI credentials ---
PRIMARY_AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# --- Toggles ---
AUTO_SEND=false
GUESSED_EMAILS_TO_DRAFT=false

# --- Volumes / thresholds ---
MAX_ACTIONS_PER_RUN=25
DISCOVERY_QUERIES_PER_RUN=40
FIT_SCORE_THRESHOLD=70
MAX_EMPLOYEES=500
FUNDING_RECENCY_MONTHS=12

# --- Storage ---
DB_PATH=leads.db

# --- Tiered Cache (V2) ---
# Upstash: rediss://USERNAME:PASSWORD@HOST:PORT  |  Local: redis://localhost:6379
REDIS_URL=

# --- Cloudflare R2 Backup (V2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=lead-engine

# --- Browser Automation (V2) ---
AUTO_APPLY=false
WELLFOUND_SESSION_FILE=wellfound_session.json

# --- Optional resume links ---
RESUME_LINK_ENGINEERING=
RESUME_LINK_GTM=